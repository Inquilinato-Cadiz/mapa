---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
}

const { title, description = "Mapa de viviendas turísticas de Cádiz y herramientas para inquilinas. Sindicato de Inquilinas e Inquilinos de Cádiz.", fullBleed = false } = Astro.props;

const social = [
  { href: "https://www.instagram.com/inquilinato_cadiz", icon: "fa-brands fa-instagram", label: "Instagram" },
  { href: "https://bsky.app/profile/inquilinatocdz.bsky.social", icon: "fa-brands fa-bluesky", label: "Bluesky" },
  { href: "https://m.facebook.com/p/Sindicato-de-Inquilinas-de-C%C3%A1diz-61572490201233/", icon: "fa-brands fa-facebook-f", label: "Facebook" },
  { href: "https://inquilinatocadiz.org", icon: "fa-solid fa-desktop", label: "Web del sindicato" },
  { href: "https://chat.whatsapp.com/G0CqD27nWeY26BUwAAZVD7", icon: "fa-brands fa-whatsapp", label: "WhatsApp" },
];
const nav = [
  { href: "/", label: "Mapa" },
  { href: "/datos/", label: "Datos" },
  { href: "/herramientas/", label: "Herramientas" },
  { href: "/denuncia/", label: "Denunciar" },
];
const path = Astro.url.pathname;
const active = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Sindicato de Inquilinas de Cádiz</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo-cabecera.png" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header id="site-header">
      <div class="bg-brand text-white">
        <div class="mx-auto flex h-9 max-w-6xl items-center justify-end gap-5 px-4 text-sm">
          {social.map((s) => (
            <a href={s.href} aria-label={s.label} title={s.label} rel="noopener" target="_blank" class="hover:opacity-80"><i class={s.icon} aria-hidden="true"></i></a>
          ))}
        </div>
      </div>
      <div class="border-b border-neutral-200 bg-white">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
          <a href="https://inquilinatocadiz.org/" class="shrink-0" title="Sindicato de Inquilinas e Inquilinos de Cádiz">
            <img src="/logo-cabecera.png" alt="Sindicato de Inquilinas e Inquilinos de Cádiz" width="726" height="162" class="h-11 w-auto" />
          </a>
          <nav class="display flex flex-wrap items-center gap-x-5 gap-y-1 text-lg tracking-wide">
            {nav.map((item) => (
              <a href={item.href} class:list={["border-b-2 pb-0.5 hover:text-brand", active(item.href) ? "border-neutral-900" : "border-transparent"]}>{item.label}</a>
            ))}
            <a href="https://inquilinatocadiz.org/afiliate/" class="rounded-md bg-brand px-3 py-1 text-white hover:bg-brand-dark">Afíliate</a>
          </nav>
        </div>
      </div>
    </header>

    <main class:list={["flex-1", { "mx-auto w-full max-w-6xl px-4 py-8": !fullBleed }]}>
      <slot />
    </main>

    <footer class="bg-neutral-950 text-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
        <a href="https://inquilinatocadiz.org/" class="display text-2xl italic leading-none" title="Sindicato de Inquilinas e Inquilinos de Cádiz">SIC</a>
        <nav class="display flex flex-wrap items-center gap-x-6 gap-y-1 text-sm italic tracking-wide">
          <a href="https://inquilinatocadiz.org/participa/" class="hover:text-brand">Participa</a>
          <a href="https://inquilinatocadiz.org/aviso-legal-y-privacidad/" class="hover:text-brand">Aviso legal y privacidad</a>
          <a href="/datos/" class="hover:text-brand">Datos</a>
          <a href="https://www.juntadeandalucia.es/datosabiertos/portal/dataset/openrta" rel="noopener" class="hover:text-brand">Fuente: OpenRTA (CC BY 4.0)</a>
        </nav>
        <div class="flex gap-4 text-lg">
          {social.map((s) => (
            <a href={s.href} aria-label={s.label} title={s.label} rel="noopener" target="_blank" class="hover:text-brand"><i class={s.icon} aria-hidden="true"></i></a>
          ))}
        </div>
      </div>
    </footer>
  </body>
</html>
