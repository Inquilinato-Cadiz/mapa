---
/** Fila de cifras grandes: [etiqueta, valor, nota opcional]. */
interface Props {
  items: (readonly [string, string] | readonly [string, string, string])[];
  cols?: 3 | 4;
}
const { items, cols = 4 } = Astro.props;
---

<dl class:list={["mt-4 grid gap-4 sm:grid-cols-2", cols === 3 ? "lg:grid-cols-3" : "lg:grid-cols-4"]}>
  {items.map(([label, value, note]) => (
    <div class="brut bg-white p-5">
      <dt class="text-sm text-neutral-600">{label}</dt>
      <dd class="display mt-1 text-4xl text-brand">{value}</dd>
      {note && <dd class="mt-1 text-xs text-neutral-500">{note}</dd>}
    </div>
  ))}
</dl>
