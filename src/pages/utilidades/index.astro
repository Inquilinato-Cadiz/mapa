---
import Base from "../../layouts/Base.astro";

const tools = [
  { href: "/utilidades/renta/", title: "¿Me pueden subir tanto el alquiler?", text: "Calcula la subida máxima legal según tu contrato y el índice que toca (IRAV o IPC), y qué contestar." },
  { href: "/utilidades/plazos/", title: "¿Hasta cuándo puedo quedarme?", text: "Prórroga obligatoria, prórroga tácita, preavisos y fechas clave de tu contrato." },
  { href: "/utilidades/contrato/", title: "¿Tiene trampas mi contrato?", text: "Repasa las cláusulas nulas o abusivas más habituales y qué dice la ley de cada una." },
  { href: "/utilidades/precio-referencia/", title: "¿Cuánto se paga por aquí?", text: "Cómo consultar el precio de referencia oficial de tu zona y para qué sirve en Cádiz." },
  { href: "/", title: "¿Hay licencia turística en mi edificio?", text: "Busca tu calle en el mapa de viviendas turísticas registradas." },
];
---

<Base title="Utilidades para inquilinas">
  <h1 class="display text-4xl">Utilidades</h1>
  <p class="mt-2 max-w-2xl text-neutral-600">Cinco preguntas que nos hacen cada semana en la asamblea, con respuesta rápida. Gratis, sin registro y sin guardar nada de lo que escribes: todo se calcula en tu navegador.</p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {tools.map((t) => (
      <li>
        <a href={t.href} class="block h-full rounded-lg border border-neutral-200 bg-white p-5 hover:border-brand">
          <h2 class="display text-2xl text-brand">{t.title}</h2>
          <p class="mt-2 text-sm text-neutral-700">{t.text}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>
