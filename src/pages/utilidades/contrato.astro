---
import Base from "../../layouts/Base.astro";
import Aviso from "../../components/Aviso.astro";

// Las explicaciones dependen de la fecha de firma (régimen legal) y del tipo de arrendador: están en contrato.ts.
const checks = [
  { id: "duration", q: "Dura un año o menos de lo que marca la ley como prórroga obligatoria" },
  { id: "waiver", q: "Renuncias a la prórroga o aceptas irte cuando te lo pidan" },
  { id: "deposit", q: "Fianza de más de un mes, o garantías adicionales muy altas" },
  { id: "agency", q: "Te cobran los honorarios de la agencia o la gestión del contrato" },
  { id: "update", q: "La renta se actualiza «libremente», «según mercado» o sin decir con qué índice" },
  { id: "seasonal", q: "Es un contrato «de temporada» pero es tu vivienda habitual" },
  { id: "census", q: "Te prohíben empadronarte" },
  { id: "penalty", q: "Penalización por irte antes superior a un mes de renta por año que falte" },
  { id: "repairs", q: "Las reparaciones y obras de conservación corren de tu cuenta" },
  { id: "expenses", q: "Pagas IBI, comunidad u otros gastos sin que el contrato diga el importe anual" },
  { id: "entry", q: "El propietario puede entrar cuando quiera o hacer visitas sin avisar" },
  { id: "sale", q: "Si venden el piso tienes que irte" },
];
const field = "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 focus:outline-brand";
---

<Base title="Comprobador de contrato de alquiler">
  <div class="max-w-2xl">
    <p class="text-sm text-neutral-500"><a href="/utilidades/" class="hover:underline">Utilidades</a> / Comprobador</p>
    <h1 class="display text-4xl">¿Tiene trampas mi contrato?</h1>
    <p class="mt-2 text-neutral-600">Lo que vale y lo que no depende de cuándo firmaste y de quién es el arrendador. Marca lo que aparezca en tu contrato y te decimos qué es nulo, qué es abusivo y con qué artículo defenderte.</p>

    <form id="contrato" class="mt-6 rounded-lg border border-neutral-200 bg-white" onsubmit="return false">
      <div class="grid gap-4 border-b border-neutral-100 p-5 sm:grid-cols-2">
        <label class="block"><span class="text-sm font-medium">Fecha de firma del contrato</span><input id="signed" type="date" required class={field} /></label>
        <label class="block"><span class="text-sm font-medium">¿Quién es el arrendador?</span>
          <select id="landlord" class={field}>
            <option value="natural">Una persona (particular)</option>
            <option value="legal">Una empresa, fondo, sociedad o entidad</option>
          </select>
        </label>
        <p id="regime" class="text-sm text-neutral-600 sm:col-span-2"></p>
      </div>
      <div class="divide-y divide-neutral-100">
        {checks.map((c) => (
          <label class="flex cursor-pointer items-start gap-3 px-5 py-3 hover:bg-neutral-50">
            <input type="checkbox" name="check" value={c.id} class="mt-1" />
            <span>{c.q}</span>
          </label>
        ))}
      </div>
      <div class="px-5 py-4">
        <button type="submit" class="rounded-md bg-brand px-4 py-2 font-bold text-white hover:bg-brand-dark">Ver resultado</button>
      </div>
    </form>

    <section id="result" class="mt-6 hidden"></section>

    <Aviso />
  </div>
</Base>

<script src="../../scripts/contrato.ts"></script>
