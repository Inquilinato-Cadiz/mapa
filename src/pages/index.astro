---
import Base from "../layouts/Base.astro";
import Video from "../components/Video.astro";
import ParticipaCards from "../components/ParticipaCards.astro";
import Agenda from "../components/Agenda.astro";
import { AFILIATE } from "../data/social";
import stats from "../data/stats.json";
import municipios from "../data/municipios.json";
import fincas from "../data/fincas.json";
import vacias from "../data/vacias.json";
import demanda from "../data/demanda.json";
import desahucios from "../data/desahucios.json";

const cadiz = municipios.municipios.find((m) => m.slug === "cadiz")!;
const fmt = (n: number) => n.toLocaleString("es-ES");
const vaciasCadiz = vacias.municipios.cadiz;
const des = desahucios.last_year;
const desYear = desahucios.last_full_year;

const headline = ["Organizadas", "contra", "el", "rentismo"];

const ticker = [
  "Sindicato de Inquilinas e Inquilinos de Cádiz",
  `${fmt(stats.province.total)} viviendas turísticas en la provincia`,
  "Sin miedo: nos quedamos",
  `${fmt(cadiz.total)} en la ciudad de Cádiz`,
  `${fmt(vaciasCadiz.empty)} viviendas vacías en Cádiz (INE)`,
  `${fmt(demanda.municipios.cadiz.activas)} familias esperan una vivienda protegida en Cádiz`,
  `${fmt(des.total)} desahucios en la provincia en ${desYear}, ${fmt(des.lau)} de alquiler`,
  "Asamblea abierta, ven sin cita",
  "Afíliate: 20, 50, 100 o 200 € al año",
];

const cifras = [
  { n: stats.province.total, label: "viviendas turísticas registradas en la provincia", href: "/datos/", cta: "Ver los datos" },
  { n: cadiz.total, label: "en la ciudad de Cádiz. ¿Hay una en tu calle?", href: "/mapa/", cta: "Buscar en el mapa" },
  { n: fincas.total, label: "fincas enteras de un único propietario en Cádiz", href: "/fincas/", cta: "Ver las fincas" },
  { n: vaciasCadiz.empty, label: "viviendas vacías en Cádiz según el consumo de luz (INE, 2021)", href: "/datos/cadiz/", cta: "Ver los datos" },
  { n: demanda.municipios.cadiz.activas, label: "familias inscritas esperando una vivienda protegida en Cádiz", href: "/datos/cadiz/", cta: "Ver los datos" },
  { n: des.total, label: `desahucios practicados en la provincia en ${desYear}, ${fmt(des.lau)} de alquiler (CGPJ)`, href: "/datos/#desahucios", cta: "Ver los datos" },
];


// Fachada gaditana en caracteres, solo decorativa.
const win = " [==] ";
const balcon = " _||_ ";
const floors = 5;
const cols = 7;
const facade = [
  " " + "_".repeat(cols * 6 + 2),
  "|" + " /\\ ".padStart(cols * 3 + 3).padEnd(cols * 6 + 2) + "|",
  ...Array.from({ length: floors }, () => [
    "|" + win.repeat(cols) + "  |",
    "|" + balcon.repeat(cols) + "  |",
  ]).flat(),
  "|" + " [  ] ".repeat(cols) + "  |",
  "|" + "_".repeat(cols * 6 + 2) + "|",
].join("\n");
---

<Base title="Organizadas contra el rentismo" fullBleed>
  <!-- Marquesina -->
  <div class="ticker display border-b-3 border-ink bg-ink py-2.5 text-lg text-white" aria-hidden="true">
    {[0, 1].map(() => (
      <p class="flex gap-6 pr-6">
        {ticker.map((t) => (
          <span class="flex items-center gap-6"><span>{t}</span><span class="text-brand">✊</span></span>
        ))}
      </p>
    ))}
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b-3 border-ink">
    <pre class="pointer-events-none absolute -right-8 top-1/2 hidden -translate-y-1/2 select-none font-mono text-[15px] leading-[1.1] text-brand/30 md:block" aria-hidden="true">{facade}</pre>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <h1 class="display max-w-4xl text-6xl md:text-8xl">
        {headline.map((w, i) => <span class="rise mr-[0.25em]" style={`--i:${i}`}>{w}</span>)}
        <span class="rise" style={`--i:${headline.length}`} aria-hidden="true">✊</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed md:text-xl">
        Somos personas que vivimos de alquiler y nos organizamos para defender el derecho a una vivienda digna, segura y asequible. Plantamos cara a los grandes propietarios, a las subidas de alquiler y a la precarización de la vida. Organizadas, hemos frenado desahucios y negociado rebajas de alquiler.
      </p>
      <div class="mt-10 flex flex-wrap gap-6">
        <a href="/participa/" class="brut brut-hover display bg-brand px-8 py-4 text-3xl text-white">Participa</a>
        <a href={AFILIATE} class="brut brut-hover display bg-white px-8 py-4 text-3xl text-brand">Afíliate</a>
      </div>
    </div>
  </section>

  <!-- Cifras del mapa -->
  <section class="border-b-3 border-ink bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-neutral-600">Datos oficiales · Registro de Turismo de Andalucía ({stats.source_updated_at}) · INE · Junta de Andalucía · CGPJ</p>
      <ul class="mt-6 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {cifras.map((c, i) => (
          <li class="reveal brut flex flex-col bg-paper p-7" style={`--i:${i}`}>
            <span class="display text-6xl text-brand" data-count={c.n}>0</span>
            <span class="mt-3 text-lg leading-snug">{c.label}</span>
            <a href={c.href} class="display mt-auto pt-5 text-lg underline decoration-3 underline-offset-4 hover:text-brand">{c.cta} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Próximas convocatorias (en vivo desde Sindicadas; la sección se quita si no hay ninguna) -->
  <section class="border-b-3 border-ink bg-brand text-white" data-agenda-section>
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="display text-5xl md:text-6xl">Próximas convocatorias</h2>
        <a href="/agenda/" class="display text-lg underline decoration-3 underline-offset-4 hover:text-ink">Toda la agenda →</a>
      </div>
      <div class="mt-8 max-w-3xl text-ink">
        <Agenda limit={3} hideEmpty />
      </div>
    </div>
  </section>

  <!-- Participa -->
  <section class="border-b-3 border-ink">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <h2 class="display text-5xl md:text-6xl">Participa</h2>
      <div class="mt-8">
        <ParticipaCards />
      </div>
    </div>
  </section>

  <!-- Vídeo -->
  <section class="border-b-3 border-ink bg-celeste">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:py-20 md:grid-cols-[1fr_2fr] md:items-center">
      <div class="reveal">
        <h2 class="display text-5xl">Las huelgas de alquileres han venido para quedarse</h2>
        <p class="mt-5 text-lg leading-relaxed">Lo que pasa en Catalunya, Madrid o Sevilla también pasa en Cádiz. Formamos parte de una red de sindicatos de inquilinas de todo el Estado.</p>
        <a href="/participa/#red" class="display mt-6 inline-block text-lg underline decoration-3 underline-offset-4 hover:text-brand">Conoce la red →</a>
      </div>
      <div class="reveal" style="--i:1">
        <Video id="0CJOl0TL8ag" title="Comença la revolta de les claus. El 5 d'abril sortim als carrers" poster="/video-revolta.jpg" credit="Sindicat de Llogateres de Catalunya" />
      </div>
    </div>
  </section>
</Base>

<script src="../scripts/inicio.ts"></script>
