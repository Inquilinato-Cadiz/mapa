    { label: "Instagram", href: "https://www.instagram.com/inquilinaszgz/" },
    { label: "Bluesky", href: "https://bsky.app/profile/inquilinaszgz.bsky.social" },
    { label: "Web", href: "https://sindicatoinquilinoszgz.wordpress.com/" },
  ] },
  { name: "Vigo", canales: [
    { label: "Instagram", href: "https://www.instagram.com/sindicato_de_inquilinas_vigo/" },
    { label: "Bluesky", href: "https://bsky.app/profile/vigo.bsky.social" },
    { label: "Facebook", href: "https://www.facebook.com/p/Sindicato-de-Inquilinas-Vigo-Tui-Baixo-Mi%C3%B1o-61551899353428/" },
    { label: "Web", href: "https://sindicatoinqulinas.blog/" },
  ] },
