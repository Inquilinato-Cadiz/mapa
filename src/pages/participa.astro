  { name: "Málaga", canales: [
    { label: "X", href: "https://x.com/inquilinatomlg" },
    { label: "Instagram", href: "https://www.instagram.com/inquilinatomlg/" },
    { label: "Facebook", href: "https://www.facebook.com/InquilinatoMalaga" },
    { label: "YouTube", href: "https://www.youtube.com/channel/UC94l_YD_GW3WpyZfsbO3OPA" },
    { label: "Web", href: "https://inquilinatomalaga.org/" },
